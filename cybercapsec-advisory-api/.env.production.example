# Production environment variables for CyberCapSec Advisory API.
#
# Copy to .env for local development or set in Railway / your platform's
# environment variable manager for production.

# ----- Application -----------------------------------------------------------
APP_NAME=CyberCapSec Advisory API
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ----- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me-with-a-strong-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# ----- Database --------------------------------------------------------------
# Railway-supplied; locally use postgres://localhost/cybercapsec
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ----- Redis -----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- AI advisor (Anthropic / Claude) ---------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-4-7
USE_MOCK_AI=false

# ----- Paystack billing ------------------------------------------------------
# Test mode: keys start with sk_test_ / pk_test_
# Live mode:  keys start with sk_live_ / pk_live_
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_CHECKOUT_CALLBACK_URL=https://app.cybercapsec.com/billing/return
USE_MOCK_PAYMENTS=false

# Plan codes (populated by `python -m app.cli sync-plans` after first deploy)
# PAYSTACK_PLAN_STARTER_NGN_MONTHLY=PLN_xxx
# PAYSTACK_PLAN_GROWTH_NGN_MONTHLY=PLN_xxx
# ... (one per tier x currency x interval combination)

# ----- CORS ------------------------------------------------------------------
CORS_ORIGINS=["https://app.cybercapsec.com","https://cybercapsec.com"]

# ----- Feature flags ---------------------------------------------------------
ENABLE_AI_REPORTS=true
