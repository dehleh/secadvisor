# Application
APP_NAME=CyberCapSec Advisory API
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Security
SECRET_KEY=change-me-to-a-random-string-min-32-chars-long-please
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybercapsec_advisory
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybercapsec_advisory_test

# Redis
REDIS_URL=redis://localhost:6379/0

# Anthropic / Claude
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-opus-4-7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Stripe (used in Session 7)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Feature flags
ENABLE_AI_REPORTS=true
USE_MOCK_AI=false
